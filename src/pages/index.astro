---
import Layout from "../layouts/Layout.astro";
import home from "../data/home.json";
---

<Layout title="Taft Hill Acres">
  <div class="text-center h-full m-auto my-8">
    <h1 class="w-full bg-tan text-4xl p-6 m-auto">
      {home.title}
    </h1>
    <div class="w-full m-auto text-center">
      {
        home.mainImage && (
          <div class="">
            <img
              decoding="async"
              width={800}
              height={600}
              class="hero-image z-10"
              src={home.mainImage}
              alt="two horse noses sticking through the gate"
              loading="eager"
            />
          </div>
        )
      }
      <div class="w-full lg:w-5/6 my-12 m-auto lg:flex justify-center">
        <p
          class="text-2xl w-full lg:w-2/5 text-center border-b-2 lg:border-b-0 lg:border-r-2 border-darktan/50 lg:pr-8"
        >
          {home.blurb}
        </p>
        <p class="text-2xl w-full lg:w-2/5 text-center lg:text-left lg:pl-16">
          {home.blurb2}
        </p>
      </div>
    </div>
    <section class="w-full bg-tan mx-auto py-8 lg:p-8">
      <div class="w-full lg:w-2/3 m-auto">
        {home.subTitle2 && <h3 class="text-black text-2xl">{home.subTitle2}</h3>}
        {home.title2 && <h2 class="text-black text-5xl text-center mb-12">{home.title2}</h2>}
        <div class="lg:flex justify-center lg:text-left text-2xl items-center">
          <div class="w-full mb-12 lg:w-1/2 p-4 lg:border-r-2">
            <Fragment set:html={home.bodyHtml} />
          </div>
          <div class="w-full lg:w-1/2 lg:py-4 p-4 lg:pl-8">
            <Fragment set:html={home.body2Html} />
          </div>
        </div>
      </div>
    </section>
  </div>
  <section class="home-masonry-section">
    <div class="home-masonry-cta home-masonry-cta--top">
      <a
        class="home-masonry-link bg-tan text-darktan p-4 text-2xl font-extrabold hover:bg-green hover:rounded"
        href={home.buttoninternalLink}
        rel="noopener noreferrer"
        >{home.button}</a
      >
    </div>

    <div class="home-masonry-grid">
      {
        home.mason && (
          <figure class="home-masonry-item home-masonry-item--offset">
            <img
              decoding="async"
              width={300}
              height={400}
              class="home-masonry-image"
              src={home.mason}
              alt="View of Taft Hill Acres horses in the pasture"
              loading="lazy"
            />
          </figure>
        )
      }
      {
        home.mason2 && (
          <figure class="home-masonry-item">
            <img
              decoding="async"
              width={300}
              height={400}
              class="home-masonry-image"
              src={home.mason2}
              alt="Taft Hill Acres arena with horse and rider and the sun in the background"
              loading="lazy"
            />
          </figure>
        )
      }
      {
        home.mason4 && (
          <figure class="home-masonry-item home-masonry-item--compact">
            <img
              decoding="async"
              width={300}
              height={400}
              class="home-masonry-image"
              src={home.mason4}
              alt="View of Taft Hill Acres at sunset"
              loading="lazy"
            />
          </figure>
        )
      }
      {
        home.mason3 && (
          <figure class="home-masonry-item home-masonry-item--offset-sm">
            <img
              decoding="async"
              width={300}
              height={400}
              class="home-masonry-image"
              src={home.mason3}
              alt="One of Taft Hill Acres pen with no horses in it"
              loading="lazy"
            />
          </figure>
        )
      }
    </div>

    <div class="home-masonry-cta home-masonry-cta--bottom">
      <a
        class="home-masonry-link bg-tan text-darktan p-4 text-2xl font-extrabold hover:bg-green hover:rounded"
        href={home.button2internalLink}
        rel="noopener noreferrer"
        >{home.button2}</a
      >
    </div>
  </section>
</Layout>

<style>
  .hero-image-wrap {
    width: min(100%, 1000px);
    margin-inline: auto;
    padding-inline: 0.75rem;
  }

  .hero-image {
    width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
    object-fit: cover;
  }

  .home-masonry-section {
    /* width: min(100%, 1080px); */
    margin: 5rem auto 0;
    padding-inline: 0.75rem;
  }

  .home-masonry-cta {
    display: flex;
    margin-block: 0 1rem;
  }

  .home-masonry-cta--top,
  .home-masonry-cta--bottom {
    justify-content: center;
  }

  .home-masonry-cta--bottom {
    margin-block: 1rem 0;
  }

  .home-masonry-link {
    display: inline-block;
  }

  .home-masonry-grid {
    column-count: 1;
    column-gap: 1rem;
  }

  .home-masonry-item {
    break-inside: avoid;
    margin: 0 0 1rem;
  }

  .home-masonry-image {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 640px) {
    .home-masonry-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .home-masonry-cta--top {
      justify-content: flex-start;
    }

    .home-masonry-cta--bottom {
      justify-content: flex-end;
    }

    .home-masonry-grid {
      column-count: 3;
      column-gap: 1.25rem;
    }

    .home-masonry-item--offset {
      margin-top: 2.25rem;
    }

    .home-masonry-item--compact {
      margin-top: 0.75rem;
    }

    .home-masonry-item--offset-sm {
      margin-top: 1.5rem;
    }
  }
</style>
