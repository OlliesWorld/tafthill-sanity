---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page not found | Taft Hill Acres">
  <section class="px-6 py-24 text-center sm:px-10 lg:px-16">
    <p class="font-serif text-8xl italic font-normal text-brand-green">404</p>
    <h1 class="mt-4 text-4xl font-medium leading-tight tracking-[-0.025em] text-brand-ink sm:text-5xl">
      Page not found.
    </h1>
    <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-brand-muted">
      That page doesn't exist. Try heading back home.
    </p>
    <div class="mt-10">
      <a href="/" class="inline-flex min-h-11 items-center rounded-lg bg-brand-green px-6 text-sm font-semibold text-brand-bg transition hover:bg-brand-green-deep">
        Back to home
      </a>
    </div>
  </section>
</Layout>
