---
import Layout from "../layouts/Layout.astro";
import about from "../data/about.json";

const galleryAlts = [
  "Cat sleeping on a hay net",
  "Five horses eating at a hay hut together",
  "Horses laying down enjoying the sun",
  "Four young horses in a pen",
  "Four horses in a shelter",
  "Landscape view with pond on the right side",
  "Horse pen covered in snow, barn in background",
  "Sunset looking east over the fence",
  "Horse and rider riding in the arena during sunset",
];
---

<Layout title="About | Taft Hill Acres">
  {/* Page hero — split layout */}
  <section aria-labelledby="about-h" class="grid items-center gap-10 px-6 py-16 sm:px-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:px-16 lg:py-20">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.08em] text-brand-green">About · since 2012</p>
      <h1 id="about-h" class="mt-4 text-5xl font-medium leading-[0.95] tracking-[-0.035em] text-brand-ink sm:text-6xl lg:text-7xl">
        A spacious, yet comfortable
        <span class="font-serif font-normal italic text-brand-green"> ten-acre boarding facility.</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-muted">
        Taft Hill Acres is located 10 minutes north-west of the C.S.U. campus. Clients can relax knowing our facility has locked gates on both ends and people who live on the property.
      </p>
    </div>
    {about.mainImage && (
      <img
        src={about.mainImage}
        alt="Looking across the bridge with the barn in the background"
        width={640}
        height={420}
        loading="eager"
        decoding="async"
        class="w-full rounded-[10rem_1.25rem_1.25rem_1.25rem] object-cover lg:h-[26rem]"
      />
    )}
  </section>

  {/* The Basics */}
  <section aria-labelledby="basics-h" class="bg-brand-soft px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <img
        src="/images/site/2ba75ca54ec21777c552e933e6887a34e0ed2a68-960x720-jpg-Pen.jpg"
        alt="Five horses eating at a hay hut together"
        width={640}
        height={480}
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl object-cover lg:h-[32rem]"
      />
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.08em] text-brand-green">The basics</p>
        <h2 id="basics-h" class="mt-3 text-4xl font-medium leading-[1.05] tracking-[-0.025em] text-brand-ink lg:text-5xl">
          Herds, hay, and a quiet routine.
        </h2>
        <div class="mt-6 text-base leading-[1.7] text-brand-muted lg:text-[17px]">
          <Fragment set:html={about.bodyHtml} />
        </div>
      </div>
    </div>
  </section>

  {/* Beyond the Basics */}
  <section aria-labelledby="beyond-h" class="bg-brand-bg px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.08em] text-brand-green">Beyond the basics</p>
        <h2 id="beyond-h" class="mt-3 text-4xl font-medium leading-[1.05] tracking-[-0.025em] text-brand-ink lg:text-5xl">
          Care plans, and a location that does half the work.
        </h2>
        <div class="mt-6 text-base leading-[1.7] text-brand-muted lg:text-[17px]">
          <Fragment set:html={about.body2Html} />
        </div>
      </div>
      <img
        src="/images/site/cc14612cf877b575663299697d4e40c5acdb1761-1440x1800-jpg-bikepath6.jpg"
        alt="Landscape view with pond on the right side"
        width={640}
        height={480}
        loading="lazy"
        decoding="async"
        class="w-full rounded-2xl object-cover lg:h-[32rem]"
      />
    </div>
  </section>

  {/* Photo gallery */}
  <section aria-labelledby="gallery-h" class="bg-brand-bg px-6 py-16 sm:px-10 lg:px-16 lg:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="mb-10 flex items-end justify-between gap-8">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.08em] text-brand-green">Around the property</p>
          <h2 id="gallery-h" class="mt-3 text-4xl font-medium leading-[1.05] tracking-[-0.025em] text-brand-ink lg:text-5xl">
            A few <span class="font-serif font-normal italic text-brand-green">moments.</span>
          </h2>
        </div>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {about.gallery.map((src, i) => (
          <img
            src={src}
            alt={galleryAlts[i] ?? ""}
            width={480}
            height={320}
            loading="lazy"
            decoding="async"
            class="w-full rounded-2xl object-cover h-56 lg:h-64"
          />
        ))}
      </div>
    </div>
  </section>

  {/* CTA strip */}
  <section class="bg-green px-6 py-14 text-center sm:px-10 lg:px-16">
    <p class="text-xs font-bold uppercase tracking-[0.08em] text-brand-soft/70">Ready to visit?</p>
    <h2 class="mx-auto mt-3 max-w-2xl text-3xl font-medium leading-snug tracking-[-0.02em] text-brand-bg lg:text-4xl">
      Come see if Taft Hill is the right fit for <span class="font-serif font-normal italic">your horse.</span>
    </h2>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="inline-flex min-h-11 items-center rounded-lg bg-brand-bg px-6 text-sm font-semibold text-brand-green-deep transition hover:bg-brand-soft">
        Request a tour
      </a>
      <a href="/facility" class="inline-flex min-h-11 items-center rounded-lg border border-brand-bg/30 px-6 text-sm font-semibold text-brand-bg transition hover:bg-white/10">
        See the facility
      </a>
    </div>
  </section>
</Layout>

