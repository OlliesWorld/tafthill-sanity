---
import { Image } from "astro:assets";
import Navigation from "./Navigation.astro";
import logo from "../assets/images/taft-hill-acres-logo.png";

const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 border-b border-brand-ink/10 bg-brand-bg/95 backdrop-blur">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-10">
    <a href="/" class="inline-flex min-h-11 items-center" aria-label="Taft Hill Acres home">
      <Image
        src={logo}
        alt="Taft Hill Acres"
        widths={[176, 208, 352, 416]}
        sizes="(min-width: 640px) 208px, 176px"
        class="w-44 mix-blend-multiply sm:w-52"
        loading="eager"
      />
    </a>

    <button
      id="menu-toggle"
      class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-brand-ink/20 bg-white/60 px-3 text-sm font-semibold text-brand-ink md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      Menu
    </button>

    <div class="hidden md:flex md:flex-1 md:justify-center">
      <Navigation currentPath={currentPath} />
    </div>

    <a
      href="/contact"
      class="hidden min-h-11 items-center rounded-lg bg-brand-green px-5 text-sm font-semibold text-brand-bg transition hover:bg-brand-green-deep lg:inline-flex"
    >
      Schedule a tour
    </a>
  </div>

  <div id="mobile-nav" class="hidden border-t border-brand-ink/10 px-4 py-4 md:hidden sm:px-6">
    <Navigation currentPath={currentPath} mobile={true} />
    <a
      href="/contact"
      class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-brand-green px-5 text-sm font-semibold text-brand-bg transition hover:bg-brand-green-deep"
    >
      Schedule a tour
    </a>
  </div>
</header>

<script is:inline>
  const menuToggle = document.querySelector("#menu-toggle");
  const mobileNav = document.querySelector("#mobile-nav");

  if (menuToggle && mobileNav) {
    menuToggle.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      mobileNav.classList.toggle("hidden", isOpen);
    });
  }
</script>
